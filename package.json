{
  "name": "isometric-map-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run lint && vite build && tsc",
    "lint": "eslint .",
    "dev": "vite",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "vitest run",
    "test:watch": "vitest",
