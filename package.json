    "import:pokemon": "node scripts/import-pokemon-sprites.mjs"
  },
  "dependencies": {
    "@pixi/sound": "6.0.1",
    "@pixi/ui": "2.3.2",
    "lodash": "4.18.1",
    "motion": "12.42.2",
    "pixi-viewport": "6.0.3",
    "pixi.js": "8.19.0"
  },
  "devDependencies": {
    "@assetpack/core": "1.7.0",
    "@eslint/js": "10.0.1",
    "@types/lodash": "4.17.24",
    "@types/pngjs": "6.0.5",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "gh-pages": "6.3.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  }
